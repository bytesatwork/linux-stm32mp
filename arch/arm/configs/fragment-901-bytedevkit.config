CONFIG_DRM_PANEL_YOURITECH_ILI9806E=y

CONFIG_DRM_FBDEV_EMULATION=y

CONFIG_DP83867_PHY=y

CONFIG_MFD_STM32_TIMERS=y
CONFIG_PWM_STM32=y

CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# CONFIG_FRAMEBUFFER_CONSOLE_ROTATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set

# Core Netfilter framework
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# nf_tables core
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y

# Connection tracking (required for ct state)
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_EVENTS=y

# nftables expressions used in nftables.conf
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y

# For protocol/port matching
CONFIG_NFT_META=y
CONFIG_NFT_RT=y
CONFIG_NFT_EXTHDR=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_SOCKET=y

# Set/map support (needed for vmap, tcp port sets, etc.)
CONFIG_NFT_SET_HASH=y
CONFIG_NFT_SET_RBTREE=y

# Protocol helpers
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES=y

# Systemd
CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
# CONFIG_SYSFS_DEPRECATED is not set
CONFIG_UEVENT_HELPER_PATH=""
# CONFIG_FW_LOADER_USER_HELPER is not set
CONFIG_DMIID=y
CONFIG_BLK_DEV_BSG=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_IPV6=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KCMP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG_SECONDARY_KEYRING=y
CONFIG_IMA_ARCH_POLICY=y
CONFIG_INTEGRITY_MACHINE_KEYRING=y
CONFIG_DMI=y
CONFIG_DMI_SYSFS=y
CONFIG_BPF_LSM=y
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_PSI=y
# CONFIG_AUDIT is not set
